{
    "name": "my-react-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
        "dev:client": "vite",
        "dev:server": "cd api && nodemon index.ts",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "dependencies": {
        "@types/styled-components": "^5.1.34",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "styled-components": "^6.1.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^6.2.1",
        "concurrently": "^8.0.1",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "nodemon": "^3.1.14",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5"
    },
    "overrides": {
        "minimatch": "11.0.5"
    }
}